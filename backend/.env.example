# ChargebackGuard Backend Environment Variables

# Database Configuration (SQLite default for MVP)
DATABASE_URL=sqlite:///./chargeback_guard.db

# JWT Auth Secret Key (Change this in production)
SECRET_KEY=chargebackguard_dev_secret_key_change_me_1234567890

# JWT Algorithm & Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Anthropic Claude API Key
# Replace this placeholder in backend/.env with your real Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173
